# Copy to .env and adjust. Everything except PUBLIC_BASE_URL has a dev default.

# Public URL of this shim (content page + FxA API). HTTPS in production.
PUBLIC_BASE_URL=http://localhost:8000

# Public URL of syncstorage-rs. Firefox will use
# ${SYNC_BASE_URL}/1.0/sync/1.5 as the token server.
SYNC_BASE_URL=http://localhost:8001

# Issuer written into access tokens. Must match the URL syncstorage uses for
# FXA_OAUTH_SERVER_URL. Inside docker compose the shim is reachable as
# http://fxa-shim:8000, so that is the default.
TOKEN_ISSUER=http://fxa-shim:8000
FXA_OAUTH_SERVER_URL=http://fxa-shim:8000

# Random 32+ byte hex string. Required in production.
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# OIDC provider (Dex, Kanidm, Authelia, Keycloak, ...).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${PUBLIC_BASE_URL}/auth/callback
OIDC_REDIRECT_URI=
# Set to 0 if your IdP does not support PKCE (Dex and Kanidm do).
OIDC_PKCE=1
# Some IdPs omit the nonce claim; setting 0 accepts that (less strict).
OIDC_REQUIRE_NONCE=1
# "post" (client_secret_post) or "basic" (client_secret_basic).
OIDC_TOKEN_AUTH=post

# Dev-only passwordless login form. Never enable in production.
DEV_LOGIN=0

# Keep passwords out of Sync by default (recommended). Set to 0 to sync them.
# server = kB on the server (simple, not E2E); e2e = separate Sync password.
KEY_MODE=server
DECLINE_PASSWORDS=1
DECLINE_ADDRESSES=1
DECLINE_CREDITCARDS=1

# syncstorage-rs secrets and database.
SYNC_MASTER_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=syncpass
# The auth-server host name expected by tokenserver; usually the accounts host.
FXA_EMAIL_DOMAIN=localhost
# The URL clients use to reach syncstorage (used as the tokenserver node URL).
SYNC_NODE_URL=http://localhost:8001
SYNCSERVER_VERSION=latest
