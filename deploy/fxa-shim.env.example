# /etc/fxa-shim/env — mode 0600, owned by root.
HOST=127.0.0.1
PORT=8000

PUBLIC_BASE_URL=https://accounts.example.com
SYNC_BASE_URL=https://sync.example.com

# Must match syncserver-rs's tokenserver.fxa_oauth_server_url.
TOKEN_ISSUER=http://127.0.0.1:8000

DATA_FILE=/var/lib/fxa-shim/state.json

# openssl rand -hex 32
SESSION_SECRET=change-me

OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=fxa-shim
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://accounts.example.com/auth/callback
# OIDC_PKCE=0
# OIDC_TOKEN_AUTH=basic
# OIDC_REQUIRE_NONCE=0

# Keep passwords out of Sync by default (the MVP stores kB server-side).
KEY_MODE=e2e
DECLINE_PASSWORDS=1
DECLINE_ADDRESSES=1
DECLINE_CREDITCARDS=1
